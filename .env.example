# ── WhatsApp AI Sales Agent Environment Variables ──────────────────────────────
PORT=3000
DATABASE_URL="file:./dev.db"

# OpenWA Gateway URL (Default local gateway port)
OPENWA_URL="http://localhost:2785"
OPENWA_API_KEY=""

# Public Webhook URL (Must point to your running app endpoint)
WHATSAPP_WEBHOOK_URL="http://localhost:3000/api/whatsapp/webhook"

# Redis Server (Optional — app defaults to in-memory KV fallback if unreachable)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# LLM Providers (Provide at least one API Key for AI responses)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
DEEPGRAM_API_KEY=""

# Optional Integrations
BROCHURE_PDF_URL=""
GOOGLE_CALENDAR_WEBHOOK_URL=""

# Zoho CRM Integration (Optional)
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_REFRESH_TOKEN=""
ZOHO_WEBHOOK_URL=""
